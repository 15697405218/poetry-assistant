DATABASE_URL=postgresql+psycopg://poetry:poetry@localhost:5432/poetry
POETRY_DATA_DIR=/path/to/chinese-poetry
CHROMA_PERSIST_DIR=./data/chroma
APP_CONFIG=config/dev.yaml
INDEX_VERSION=v2
RETRIEVE_TOP_K=5
RECALL_K=15
POEM_DISTANCE_MAX=1.2
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
RAW_TOKEN_LIMIT=100000
KEEP_LOW=15
REDIS_URL=redis://localhost:6379/0
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW=60
LOGIN_FAIL_MAX=5
LOGIN_LOCK_SECONDS=900
CACHE_TTL_SECONDS=21600
ARK_API_KEY=
BASE_URL=https://ark.cn-beijing.volces.com/api/v3
CHAT_MODEL=
TAVILY_API_KEY=
RERANKER_MODEL=BAAI/bge-reranker-large
HNSW_SEARCH_EF=64
GPU_MAX_INFLIGHT=1
JOB_TTL_SECONDS=3600
JOB_WAIT_SECONDS=180
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ACCESS_TOKEN_MAX_MINUTES=1440
